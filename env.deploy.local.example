# Copy to .env.deploy.local and fill in (never commit .env.deploy.local)
#
# Full image ref you will build and push (must match what the Web App can pull)
DEPLOY_IMAGE=ghcr.io/YOUR_GITHUB_USER/gpta-website-crawler:local-dev

# --- GHCR (default if DEPLOY_IMAGE starts with ghcr.io/) ---
GHCR_USERNAME=YOUR_GITHUB_USER
GHCR_TOKEN=                           # PAT: write:packages — do not commit real token
# gh auth token is often missing write:packages; use a PAT here or: gh auth refresh -h github.com -s write:packages

# --- Azure Web App (Linux container) ---
# Resource name from `az webapp list -g ...` (Name column), not the hostname prefix before .azurewebsites.net
AZURE_WEBAPP_NAME=website-crawler
AZURE_RESOURCE_GROUP=mpn-aicg-hotelai-perm-dev-rg-ae

# --- Optional: Azure Container Registry instead of GHCR ---
# Set DEPLOY_IMAGE=myregistry.azurecr.io/gpta-website-crawler:local-dev
# ACR_LOGIN_SERVER=myregistry.azurecr.io
# ACR_USERNAME=
# ACR_PASSWORD=
