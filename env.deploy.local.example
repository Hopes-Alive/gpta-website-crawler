# Copy to .env.deploy.local and fill in (never commit .env.deploy.local)
#
# Full image ref you will build and push (must match what the Web App can pull)
DEPLOY_IMAGE=crexpressagentprodaue.azurecr.io/gpta-website-crawler:local-dev

# Express Agent Pay-As-You-Go subscription. Required so az does not use another signed-in subscription.
AZURE_SUBSCRIPTION_ID=b996c037-ba63-4d7c-9ffb-b3c2e8e99e54

# --- Azure Web App (Linux container) ---
# Resource name from `az webapp list -g ...` (Name column), not the hostname prefix before .azurewebsites.net
AZURE_WEBAPP_NAME=app-expressagent-crawler-prod-aue
AZURE_RESOURCE_GROUP=expressagent-perm-prod-rg-ae

# --- Azure Container Registry (admin disabled; az acr login + user-assigned identity pull) ---
ACR_NAME=crexpressagentprodaue
ACR_LOGIN_SERVER=crexpressagentprodaue.azurecr.io
ACR_IDENTITY_NAME=id-expressagent-crawler-prod-aue

# --- Optional: GitHub Container Registry instead of ACR ---
# DEPLOY_IMAGE=ghcr.io/YOUR_GITHUB_USER/gpta-website-crawler:local-dev
# GHCR_USERNAME=YOUR_GITHUB_USER
# GHCR_TOKEN=                           # PAT: write:packages — do not commit real token
